# 手元で動かすときの、環境変数の見本。
# このファイルを .env.local の名前で写し、値を入れる(.env.local は、コミットしない)。
# Supabase の値は、npx supabase status -o env の表示の API_URL、PUBLISHABLE_KEY、SECRET_KEY から写す。
# どの値も、ブラウザに渡さない(名前に NEXT_PUBLIC_ を付けない)。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 環境の判別に使う(development、staging、production)。
APP_ENV=development
# Stripe のサンドボックスのシークレットキー(sk_test_ で始まるもの)。開発のサンドボックス(emu-farm-ec-development)の値を入れる。
STRIPE_SECRET_KEY=
# テスト用の連結アカウントの ID(acct_ で始まるもの)。scripts/create-test-connected-account.mjs で登録したものを入れる(TST-024)。
STRIPE_TEST_CONNECTED_ACCOUNT_ID=
