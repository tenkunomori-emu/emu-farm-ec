# 検証の Supabase のプロジェクトの値。このファイルを .env にコピーし、値を入れる。
# .env はコミットしない(リポジトリの .gitignore で除いている)。
SUPABASE_URL=https://gpxqqrzpgcfqstvnxkxo.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# 確かめ用に新しく作ったシークレットキー。確かめたあとに、ダッシュボードで削除する。
SUPABASE_SECRET_KEY=
# 04-send-email-hook.ts でメールを頼むアドレス。Supabase の Organization のメンバーのメールアドレスにする。
SPIKE_INBOX_EMAIL=
